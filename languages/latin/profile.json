{
  "schema": 1,
  "id": "latin",

  "l2": {
    "code": "la",
    "name": "Latin",
    "endonym": "Latina",
    "script": "latn",
    "direction": "ltr"
  },
  "l1": { "code": "en", "name": "English" },

  "fold": {
    "trim": true,
    "caseFold": "lower",
    "decompose": "NFD",
    "stripMarks": ["\\u0300-\\u036f"],
    "keepMarks": [],
    "map": [["j", "i"], ["v", "u"]],
    "recompose": "none"
  },

  "enclitics": ["que", "ve", "ne"],

  "paradigms": {
    "noun": [
      {
        "rows": [
          ["nominative", "Nom."], ["genitive", "Gen."], ["dative", "Dat."],
          ["accusative", "Acc."], ["ablative", "Abl."], ["vocative", "Voc."],
          ["locative", "Loc."]
        ],
        "columns": [["singular", "Singular"], ["plural", "Plural"]]
      }
    ],
    "adj": [
      {
        "rows": [
          ["nominative", "Nom."], ["genitive", "Gen."], ["dative", "Dat."],
          ["accusative", "Acc."], ["ablative", "Abl."], ["vocative", "Voc."]
        ],
        "columns": [
          ["masculine,singular", "M. sing."], ["feminine,singular", "F. sing."],
          ["neuter,singular", "N. sing."], ["masculine,plural", "M. plur."],
          ["feminine,plural", "F. plur."], ["neuter,plural", "N. plur."]
        ]
      }
    ],
    "pron": [
      {
        "rows": [
          ["nominative", "Nom."], ["genitive", "Gen."], ["dative", "Dat."],
          ["accusative", "Acc."], ["ablative", "Abl."]
        ],
        "columns": [
          ["masculine,singular", "M. sing."], ["feminine,singular", "F. sing."],
          ["neuter,singular", "N. sing."], ["masculine,plural", "M. plur."],
          ["feminine,plural", "F. plur."], ["neuter,plural", "N. plur."]
        ]
      }
    ],
    "det": [
      {
        "rows": [
          ["nominative", "Nom."], ["genitive", "Gen."], ["dative", "Dat."],
          ["accusative", "Acc."], ["ablative", "Abl."]
        ],
        "columns": [
          ["masculine,singular", "M. sing."], ["feminine,singular", "F. sing."],
          ["neuter,singular", "N. sing."], ["masculine,plural", "M. plur."],
          ["feminine,plural", "F. plur."], ["neuter,plural", "N. plur."]
        ]
      }
    ],
    "num": [
      {
        "rows": [
          ["nominative", "Nom."], ["genitive", "Gen."], ["dative", "Dat."],
          ["accusative", "Acc."], ["ablative", "Abl."]
        ],
        "columns": [
          ["masculine,singular", "M. sing."], ["feminine,singular", "F. sing."],
          ["neuter,singular", "N. sing."], ["masculine,plural", "M. plur."],
          ["feminine,plural", "F. plur."], ["neuter,plural", "N. plur."]
        ]
      }
    ],
    "verb": [
      {
        "title": "Indicative, active",
        "rows": [
          ["present,indicative,active", "Present"],
          ["imperfect,indicative,active", "Imperfect"],
          ["future,indicative,active", "Future"],
          ["perfect,indicative,active", "Perfect"],
          ["pluperfect,indicative,active", "Pluperfect"],
          ["future,perfect,indicative,active", "Future perfect"]
        ],
        "columns": [
          ["first-person,singular", "1 sing."], ["second-person,singular", "2 sing."],
          ["third-person,singular", "3 sing."], ["first-person,plural", "1 plur."],
          ["second-person,plural", "2 plur."], ["third-person,plural", "3 plur."]
        ]
      },
      {
        "title": "Indicative, passive",
        "rows": [
          ["present,indicative,passive", "Present"],
          ["imperfect,indicative,passive", "Imperfect"],
          ["future,indicative,passive", "Future"],
          ["perfect,indicative,passive", "Perfect"],
          ["pluperfect,indicative,passive", "Pluperfect"],
          ["future,perfect,indicative,passive", "Future perfect"]
        ],
        "columns": [
          ["first-person,singular", "1 sing."], ["second-person,singular", "2 sing."],
          ["third-person,singular", "3 sing."], ["first-person,plural", "1 plur."],
          ["second-person,plural", "2 plur."], ["third-person,plural", "3 plur."]
        ]
      },
      {
        "title": "Subjunctive, active",
        "rows": [
          ["present,subjunctive,active", "Present"],
          ["imperfect,subjunctive,active", "Imperfect"],
          ["perfect,subjunctive,active", "Perfect"],
          ["pluperfect,subjunctive,active", "Pluperfect"]
        ],
        "columns": [
          ["first-person,singular", "1 sing."], ["second-person,singular", "2 sing."],
          ["third-person,singular", "3 sing."], ["first-person,plural", "1 plur."],
          ["second-person,plural", "2 plur."], ["third-person,plural", "3 plur."]
        ]
      },
      {
        "title": "Subjunctive, passive",
        "rows": [
          ["present,subjunctive,passive", "Present"],
          ["imperfect,subjunctive,passive", "Imperfect"],
          ["perfect,subjunctive,passive", "Perfect"],
          ["pluperfect,subjunctive,passive", "Pluperfect"]
        ],
        "columns": [
          ["first-person,singular", "1 sing."], ["second-person,singular", "2 sing."],
          ["third-person,singular", "3 sing."], ["first-person,plural", "1 plur."],
          ["second-person,plural", "2 plur."], ["third-person,plural", "3 plur."]
        ]
      },
      {
        "title": "Imperative",
        "rows": [
          ["present,imperative,active", "Present active"],
          ["future,imperative,active", "Future active"],
          ["present,imperative,passive", "Present passive"],
          ["future,imperative,passive", "Future passive"]
        ],
        "columns": [
          ["second-person,singular", "2 sing."], ["third-person,singular", "3 sing."],
          ["second-person,plural", "2 plur."], ["third-person,plural", "3 plur."]
        ]
      }
    ]
  },

  "families": [
    { "id": "nouns", "label": "Nouns" },
    { "id": "adj", "label": "Adjectives & adverbs" },
    { "id": "pron", "label": "Pronouns" },
    { "id": "verb-forms", "label": "Verb forms" },
    { "id": "particles", "label": "Particles" },
    { "id": "noun-syntax", "label": "Noun syntax" },
    { "id": "adj-pron-syntax", "label": "Adjective & pronoun syntax" },
    { "id": "verb-syntax", "label": "Verb syntax" },
    { "id": "style", "label": "Word-order & style" }
  ],
  "fallbackFamily": "style",

  "grammar": {
    "source": {
      "title": "Charles E. Bennett, New Latin Grammar (Boston, 1908)",
      "url": "https://www.gutenberg.org/files/15665/15665-h/15665-h.htm",
      "licence": "public domain (Project Gutenberg ebook #15665)"
    },
    "idPrefix": "bn",
    "refPrefix": "§ ",
    "paradigmLabels": [
      "nom", "gen", "dat", "acc", "abl", "voc", "loc",
      "sing", "singular", "plur", "plural",
      "1st", "2nd", "3rd", "1", "2", "3"
    ],
    "headingPattern": "^[A-Z][A-Z .,'’—-]*\\.?$",
    "headingFlags": "",
    "headingMaxLength": 40
  },

  "questions": {
    "defaultKind": "translate-en-la",
    "produceKinds": ["translate-en-la"]
  },

  "citationsVersion": 4,

  "ui": {
    "appName": "Latina",
    "manifestName": "Latina — Latin tutor",
    "description": "A spaced-repetition Latin tutor. Translate into Latin, grade yourself, and watch the grammar fill in.",
    "promptDirection": "Translate into Latin",
    "cliPlaceholder": "type your Latin, then Enter…",
    "cliHint": "type your Latin",
    "webPlaceholder": "write your Latin…",
    "answerAriaLabel": "Your Latin",
    "sayItIn": "say it in Latin",
    "themeColor": "#12121a",
    "backgroundColor": "#12121a"
  },

  "storage": {
    "webProgressKey": "latin-tutor:progress",
    "webSyncKey": "latin-tutor:sync",
    "cliDir": ".latin-tutor",
    "githubPath": "latin-progress.json",
    "exportPrefix": "latina-progress",
    "dictionaryCacheName": "latina-dictionary"
  },

  "grammarShape": {
    "minTopics": 60,
    "maxTopics": 300,
    "minTextChars": 120,
    "maxTextChars": 24000,
    "medianTextCharsRange": [400, 4000],
    "p90TextCharsMax": 8000,
    "maxFamilySharePct": 45
  },

  "coverage": {
    "minTestsPerTopic": 6,
    "minQuestionsPerTopic": 16,
    "topicsWithTestsPct": 100,
    "maxDuplicatePromptPct": 1.0,
    "minDictResolvedPct": 90,
    "minBandUtilisationPct": 25,
    "minKeptRatioPct": 40
  }
}
