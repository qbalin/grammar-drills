node_modules/
dist/
*.tsbuildinfo
.DS_Store
# Left behind by the packs' Python grammar parsers.
__pycache__/
# Progress files are user data, never committed to the app repo
*.progress.json
# Built from content/ by scripts/build-web-content.mjs and make-icons.mjs on
# every web build; committing it would duplicate 5 MB already in the repo.
apps/web/public/content/
apps/web/public/icons/

# The generation stats lock, held only while a run appends its record.
languages/*/content/gen-stats.json.lock

# The reference databases and the corpus they are built from: hundreds of
# megabytes, built locally by scripts/reference/ and needed only to add a
# language or rebuild a pack's citations. The distilled frequency list beside
# them — reference/frequency.tsv.gz — is committed, and is what the gates read.
languages/*/reference/*.db
languages/*/reference/texts/
# Dropped beside them by `snapshot.mjs restore`: what it unpacked, and the
# licence the archive is conveyed under.
languages/*/reference/PROVENANCE.txt
languages/*/reference/LICENSE.*
# Downloads the ingest scripts cache rather than re-fetch.
.cache/

# Reference images dropped in while redrawing the confetti. Megabytes of
# photographs of shields and coins; the drawings they informed are the artefact
# worth keeping, and they carry no licence anyone here checked.
tmp_images/

# Scratch log from the Latin quote-pool watcher (see REVIEW.md, gate C9).
.latin-finish.log

# What build-quote-pool.mjs has been told so far, so a run that dies is worth
# what it spent. Deleted the moment content/quotes.jsonl.gz — the artifact it
# stands in for — is written.
languages/*/content/.quotes.partial.jsonl
