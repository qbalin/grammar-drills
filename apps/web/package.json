{
  "name": "@lang-tutor/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "content": "node ../../scripts/build-web-content.mjs && node scripts/make-icons.mjs",
    "dev": "pnpm content && vite",
    "build": "pnpm content && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lang-tutor/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
