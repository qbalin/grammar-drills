node_modules/
dist/
*.tsbuildinfo
.DS_Store
# Left behind by the packs' Python grammar parsers.
__pycache__/
# Progress files are user data, never committed to the app repo
*.progress.json
# Built from content/ by scripts/build-web-content.mjs and make-icons.mjs on
# every web build; committing it would duplicate 5 MB already in the repo.
apps/web/public/content/
apps/web/public/icons/

# The generation stats lock, held only while a run appends its record.
languages/*/content/gen-stats.json.lock
