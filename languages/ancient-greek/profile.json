    { "id": "pron", "label": "Pronouns" },
    { "id": "verb-forms", "label": "Verb forms" },
    { "id": "word-formation", "label": "Word formation" },
    { "id": "sentence-syntax", "label": "The simple sentence" },
    { "id": "adj-pron-syntax", "label": "Article, adjective & pronoun syntax" },
    { "id": "case-syntax", "label": "Cases & prepositions" },
    { "id": "verb-syntax", "label": "Verb syntax" },
